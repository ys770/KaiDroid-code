// Not in PRODUCT_PACKAGES. Stage only in an isolated build lane.
cc_binary {
    name: "kaidroid-camera-lazy-experiment",
    vendor: true,
    compile_multilib: "32",
    srcs: ["service.cpp"],
    local_include_dirs: ["include"],
    shared_libs: [
        "android.hardware.camera.provider@2.4",
        "libbinder",
        "libcutils",
        "libhidlbase",
        "liblog",
        "libutils",
    ],
    cflags: ["-Wall", "-Wextra", "-Werror"],
}
