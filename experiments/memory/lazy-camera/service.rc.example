# UNINSTALLED: integration must prove effective init definition and SELinux/linker routes.
# disabled suppresses automatic class startup; interface lookup must still start it.
service vendor.camera-provider-2-4 /odm/kaidroid/bin/kaidroid-camera-lazy-experiment
    override
    interface android.hardware.camera.provider@2.4::ICameraProvider legacy/0
    disabled
    oneshot
    class hal
    user cameraserver
    group audio camera input drmrpc
    ioprio rt 4
    capabilities SYS_NICE
    writepid /dev/cpuset/camera-daemon/tasks /dev/stune/foreground/tasks
